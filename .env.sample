PORT=8080

# Public base URL of the app. Used for links in emails, the Google OAuth
# redirect URI, and the Secure cookie flag (https => Secure).
BASE_URL=http://localhost:8080

# Google OAuth (create an OAuth client in Google Cloud console; authorized
# redirect URI must be BASE_URL/auth/google/callback). Leave empty to disable
# Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP for password reset and admin invite emails. Leave SMTP_HOST empty to
# log emails to stdout instead (dev mode). Gmail requires an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
